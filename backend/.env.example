# Ledger Lens — Environment Variables Template
# Copy to .env and fill in your values

# Application
APP_ENV=development
APP_NAME="Ledger Lens"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=change_this_in_production_use_random_32_chars

# Database
# SQLite (default, no infrastructure needed)
DATABASE_URL=sqlite+aiosqlite:///./ledger_lens.db

# PostgreSQL (when available)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ledger_lens

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data Paths (relative to backend/ directory)
RAW_DATA_DIR=../data/raw
PROCESSED_DATA_DIR=../data/processed
MODELS_DIR=../models

# ML Configuration
ANOMALY_CONTAMINATION=0.05
ANOMALY_RANDOM_STATE=42
SIMILARITY_THRESHOLD=0.75
RISK_WEIGHT_FINANCIAL=0.30
RISK_WEIGHT_PROGRESS=0.20
RISK_WEIGHT_TIMELINE=0.20
RISK_WEIGHT_RULES=0.15
RISK_WEIGHT_SIMILARITY=0.10
RISK_WEIGHT_DATA_QUALITY=0.05

# Demo Mode
# Set to true to include synthetic demo project records alongside real data
DEMO_MODE=true
DEMO_PROJECTS_COUNT=200
